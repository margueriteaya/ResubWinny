  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:contract && svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:worker": "cargo build --manifest-path ../Cargo.toml -p arib-caption-worker --release --features libaribtlv",
    "build:bundle": "npm run build:worker && npm run build",
    "verify:contract": "node ../scripts/verify-frontend-contract.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "^1.0.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "macos-traffic-lights": "^1.1.0",
    "svelte": "^5.55.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.0",
    "@tsconfig/svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.4.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  }
}
